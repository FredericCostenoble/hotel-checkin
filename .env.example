# Kopieer naar .env (lokaal) of zet als App Settings / Key Vault-referenties in Azure.
# Geen echte waarden in dit bestand.

# Omgeving: prd (productie), tst (test in Azure) of dev (codespace, standaard).
# Buiten prd gaat elk bericht naar TEST_EMAIL / TEST_PHONE in plaats van naar de gast.
APP_ENV=dev
TEST_EMAIL=
TEST_PHONE=

KEY_VAULT_URL=https://<naam>.vault.azure.net/

# Aanmelden bij Microsoft (app registration hotel-checkin, tenant Hotel Lucca)
# In Codespaces als secrets instellen, nooit in een bestand in git.
AZURE_TENANT_ID=8b83d9fd-b5d5-440a-8a3f-2e72d49228a8
AZURE_CLIENT_ID=8f92b706-81a1-443c-9ac9-6806bb2d481c
AZURE_CLIENT_SECRET=

# Mail (Microsoft Graph). Standaardafzender; per hotel staat de afzender in config/hotels/<id>.toml
MAIL_SENDER=checkin@hotellucca.be

# Twilio (SMS, WhatsApp, Voice)
# Gedeeld account. Afzendnummers per hotel: config/hotels/<hotel_id>.toml [twilio]
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Lighthouse (robotgebruiker per hotel, zonder MFA). Adres: config/hotels/<hotel_id>.toml [lighthouse]
# In Azure: Key Vault <hotel_id>-lighthouse-username / <hotel_id>-lighthouse-password
LUCCA_LIGHTHOUSE_USERNAME=
LUCCA_LIGHTHOUSE_PASSWORD=

# Salto KS Connect
SALTO_API_BASE_URL=
SALTO_CLIENT_ID=
SALTO_CLIENT_SECRET=
SALTO_SITE_ID=

# Opslag gastgegevens
STORAGE_TABLE_ENDPOINT=https://<account>.table.core.windows.net

# Nachtverantwoordelijke (doorschakelen bij noodgeval)
NIGHT_CONTACT_PHONE=
