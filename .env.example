# Kopieer naar .env (lokaal) of zet als App Settings / Key Vault-referenties in Azure.
# Geen echte waarden in dit bestand.

KEY_VAULT_URL=https://<naam>.vault.azure.net/

# Mail (Microsoft Graph)
MAIL_SENDER=checkin@<domein>

# Twilio (SMS, WhatsApp, Voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Lighthouse (robotgebruiker)
LIGHTHOUSE_BASE_URL=https://reservationmanager.mylighthouse.com
LIGHTHOUSE_USERNAME=
LIGHTHOUSE_PASSWORD=
LIGHTHOUSE_TOTP_SECRET=

# Salto KS Connect
SALTO_API_BASE_URL=
SALTO_CLIENT_ID=
SALTO_CLIENT_SECRET=
SALTO_SITE_ID=

# Opslag gastgegevens
STORAGE_TABLE_ENDPOINT=https://<account>.table.core.windows.net

# Nachtverantwoordelijke (doorschakelen bij noodgeval)
NIGHT_CONTACT_PHONE=
